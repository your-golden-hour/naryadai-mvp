DATABASE_URL="postgresql://postgres:postgres@localhost:5432/naryadai?schema=public"

# Auth session secret
SESSION_SECRET="change-me-in-prod"

# OpenAI-compatible LLM (optional; deterministic rule-based fallback is used if empty)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Web Push VAPID keys. Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:demo@naryadai.local"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
